# Copy to backend/.env and fill in. Only the first block is required to boot;
# everything else turns on an optional integration.

# ─── Required ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml at the repo root (`docker compose up -d`).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vietix

REDIS_HOST=localhost
REDIS_PORT=6379

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000
FRONTEND_URL=http://localhost:3001

# ─── Hosted database / Redis (production) ────────────────────────────────────
# A single URL overrides the DB_* / REDIS_* values above.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DB_SSL=true
# REDIS_URL=rediss://default:pass@host:6379
# REDIS_PASSWORD=

# ─── Google sign-in ──────────────────────────────────────────────────────────
# The app needs some value here to boot; real ones from Google Cloud Console
# are only needed to actually sign in with Google.
GOOGLE_CLIENT_ID=dev-placeholder
GOOGLE_CLIENT_SECRET=dev-placeholder
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── Cloudinary (event banner uploads) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (tickets, password reset OTP, contact form) ───────────────────────
# Without these, OTP codes are printed to the backend console instead.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
ADMIN_EMAIL=

# ─── VNPay (sandbox) ─────────────────────────────────────────────────────────
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3001/checkout/vnpay-return

# ─── MoMo ────────────────────────────────────────────────────────────────────
# Leave unset to use MoMo's public sandbox test credentials.
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3001/checkout/momo-return
MOMO_IPN_URL=http://localhost:3000/payments/momo/ipn

# ─── VietQR ──────────────────────────────────────────────────────────────────
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# Production: SePay watches the account and confirms transfers through
# POST /payments/vietqr/webhook. In SePay create a webhook to that URL with
# "API Key" authentication and paste the same key here.
# SEPAY_API_KEY=
# Development only: the buyer's own "I paid" click confirms the order
# (free tickets). Never set this in production.
# VIETQR_MANUAL_CONFIRM=true
